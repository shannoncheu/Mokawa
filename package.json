{
  "name": "mokawa-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --logLevel warn",
    "test": "vitest run",
    "test:ui": "playwright test",
    "desktop": "tauri",
    "desktop:build": "tauri build --target x86_64-pc-windows-msvc",
    "licenses": "node scripts/licenses.mjs",
    "format:check": "prettier --check \"web/**/*.{vue,ts,css,html}\" scripts/tauri-desktop-test.mjs scripts/licenses.mjs vite.config.ts vitest.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@lucide/vue": "1.59.0",
    "@tauri-apps/api": "2.12.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
