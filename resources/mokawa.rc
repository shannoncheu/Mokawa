#include <winver.h>
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Mokawa contributors\0"
            VALUE "FileDescription", "Mokawa\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductName", "Mokawa\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "Comments", "A calmer way to manage your files.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
